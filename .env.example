# --- Frontend (Vite) ---
# Panel de tu proyecto Supabase > Settings > API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Script de seed (scripts/seed.ts, se ejecuta con Node, no con Vite) ---
# La Service Role Key tiene permisos totales y evita RLS: NUNCA la uses
# en el frontend, solo en scripts/funciones que corren en el servidor.
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Captcha (opcional, recomendado contra bots / DDoS de capa 7) ---
# Cloudflare Turnstile > Add site. La Site Key es publica (va al
# frontend); la Secret Key va SOLO a Supabase (ver README).
VITE_TURNSTILE_SITE_KEY=

# --- Buscador de direcciones (opcional) ---
# Por defecto el checkout usa el servidor publico de Photon
# (https://photon.komoot.io, datos de OpenStreetMap, sin clave). Solo
# definela si montas tu propia instancia de Photon.
# VITE_PHOTON_URL=https://photon.tu-dominio.cl
